GEMINI_API_KEY=AIzaS
# Options: 
#      gemini-3.8-flash, gemini-3.7-flash, gemini-3.6-flash, gemini-3.5-flash, gemini-3.1-pro-preview, gemini-2.5-flash
GEMINI_MODEL=gemini-3.8-flash
# Options: gemini-embedding-2, gemini-embedding-001
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# DeepSeek API Configuration (used for summaries, tasks, daily recap, and knowledge base)
DEEPSEEK_API_KEY=sk-...
# Options: deepseek-flash, deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Maximum output tokens per DeepSeek call (reasoning + answer). Max: 393216
DEEPSEEK_MAX_TOKENS=32768
# Thinking mode: disabled (default, faster and avoids truncation), enabled, or default to use the API default
DEEPSEEK_THINKING=disabled

# Default AI Provider for summaries and AI activities: gemini or deepseek
AI_PROVIDER=gemini

DATABASE_NAME=agendino.db

NOTION_API_KEY=ntn_...
NOTION_PAGE_ID=your-parent-page-id-here

# Options: tiny, base, small, medium, large, large-v2, large-v3, turbo
WHISPER_MODEL_SIZE=small
# Options: cpu, cuda, mps
WHISPER_DEVICE=cpu
# Options: auto, int8, int8_float16, float16, float32
WHISPER_COMPUTE_TYPE=auto

# Authentication
# Enabled by default. The first login creates the permanent account
# (see docs/authentication.md).
AUTH_ENABLED=true
# Trust X-Forwarded-For / X-Real-IP headers. Enable ONLY behind a trusted
# reverse proxy; when enabled, IP bans use the forwarded client IP instead of
# the proxy IP.
TRUST_PROXY_HEADERS=false
